"""
BadgeOS polished USB HID demo mode.

Provides a harmless USB keyboard demonstration with selectable
Linux, Windows, and macOS host profiles.

Short press executes the HID demonstration.
Long-press mode switching remains handled globally by BadgeOS.
"""

import time

from badgeos.core import Mode
from badgeos.drivers import KeyboardDriver
from badgeos.logger import get_logger


class HIDDemoMode(Mode):
    """
    USB HID toolkit demonstration mode.
    """

    VALID_HOSTS = (
        "linux",
        "windows",
        "macos",
    )

    COLOR_READY = (255, 0, 255)
    COLOR_ARMING = (255, 180, 0)
    COLOR_EXECUTING = (0, 180, 255)
    COLOR_SUCCESS = (0, 255, 0)
    COLOR_ERROR = (255, 0, 0)

    def __init__(
        self,
        events,
        led,
        host_profile="linux",
    ):
        super().__init__("HIDDemo")

        self.events = events
        self.led = led
        self.log = get_logger(self.name)

        self.keyboard = None

        self.host_profile = self._normalize_host(
            host_profile
        )

        self.state = "stopped"
        self._send_count = 0

    # ---------------------------------------------------------
    # Mode lifecycle
    # ---------------------------------------------------------

    def start(self):
        super().start()

        self._send_count = 0

        try:
            self.keyboard = KeyboardDriver()

        except Exception as exc:
            self.keyboard = None
            self.state = "error"

            self.log.error(
                "Keyboard initialization failed: {}".format(
                    exc
                )
            )

            self.led.fill(
                self.COLOR_ERROR
            )

            return

        self.events.subscribe(
            "button.short_press",
            self._on_short_press,
        )

        self._show_ready()

        self.log.info(
            "HID demo started"
        )

        self.log.info(
            "Host profile: {}".format(
                self.host_profile
            )
        )

        self.log.info(
            "Short press executes HID demo"
        )

    def stop(self):
        self.events.unsubscribe(
            "button.short_press",
            self._on_short_press,
        )

        if self.keyboard is not None:
            self.keyboard.deinit()
            self.keyboard = None

        self.state = "stopped"

        self.led.off()

        self.log.info(
            "HID demo stopped"
        )

        super().stop()

    # ---------------------------------------------------------
    # Button handling
    # ---------------------------------------------------------

    def _on_short_press(
        self,
        event_name,
        data,
    ):
        if not self.active:
            return

        if self.keyboard is None:
            self.state = "error"

            self.led.fill(
                self.COLOR_ERROR
            )

            self.log.error(
                "Keyboard unavailable"
            )

            return

        self._send_count += 1

        self.log.info(
            "Executing HID demo #{} ({})".format(
                self._send_count,
                self.host_profile,
            )
        )

        try:
            # -----------------------------
            # ARMING
            # -----------------------------

            self.state = "arming"

            self.led.fill(
                self.COLOR_ARMING
            )

            time.sleep(
                0.35
            )

            # -----------------------------
            # EXECUTING
            # -----------------------------

            self.state = "executing"

            self.led.fill(
                self.COLOR_EXECUTING
            )

            self._execute_demo()

            # -----------------------------
            # SUCCESS
            # -----------------------------

            self.state = "success"

            self.led.fill(
                self.COLOR_SUCCESS
            )

            time.sleep(
                0.40
            )

            self._show_ready()

            self.log.info(
                "HID demo sequence complete"
            )

        except Exception as exc:
            self.state = "error"

            self.led.fill(
                self.COLOR_ERROR
            )

            self.log.error(
                "HID sequence failed: {}".format(
                    exc
                )
            )

    # ---------------------------------------------------------
    # HID dispatcher
    # ---------------------------------------------------------

    def _execute_demo(self):
        if self.host_profile == "linux":
            self._demo_linux()

        elif self.host_profile == "windows":
            self._demo_windows()

        elif self.host_profile == "macos":
            self._demo_macos()

        else:
            raise ValueError(
                "Unknown HID host profile: {}".format(
                    self.host_profile
                )
            )

    # ---------------------------------------------------------
    # Linux / Fedora GNOME demo
    # ---------------------------------------------------------

    def _demo_linux(self):
        """
        Fedora/GNOME-oriented HID demonstration.

        Opens the GNOME application launcher using Super,
        searches for Terminal, launches it, displays two
        harmless BadgeOS messages, then opens the SECcon
        website using xdg-open.
        """

        # -------------------------------------------------
        # Open GNOME application search.
        # -------------------------------------------------

        self.keyboard.press(
            self.keyboard.MOD_LEFT_GUI
        )

        time.sleep(
            0.15
        )

        self.keyboard.release_all()

        # Give GNOME Shell time to display search.
        time.sleep(
            0.60
        )

        # -------------------------------------------------
        # Search for Terminal.
        # -------------------------------------------------

        self.keyboard.write(
            "terminal"
        )

        time.sleep(
            0.25
        )

        self.keyboard.enter()

        # Give Terminal plenty of time to launch and
        # receive keyboard focus.
        time.sleep(
            1.25
        )

        # -------------------------------------------------
        # Visible demo payload.
        # -------------------------------------------------

        self.keyboard.write(
            "echo '[BadgeOS] USB HID demo active'"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        self.keyboard.write(
            "echo '[BadgeOS] Host profile: Linux'"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        # -------------------------------------------------
        # Open the conference website.
        # -------------------------------------------------

        self.keyboard.write(
            "xdg-open https://seccon.com"
        )

        self.keyboard.enter()

    # ---------------------------------------------------------
    # Windows demo
    # ---------------------------------------------------------

    def _demo_windows(self):
        """
        Windows HID demonstration.

        Opens the Run dialog, launches cmd.exe, displays
        two harmless BadgeOS messages, then opens the
        conference website.
        """

        self.keyboard.hotkey(
            self.keyboard.MOD_LEFT_GUI,
            self.keyboard.KEYCODES["r"],
        )

        time.sleep(
            0.50
        )

        self.keyboard.write(
            "cmd"
        )

        self.keyboard.enter()

        time.sleep(
            0.65
        )

        self.keyboard.write(
            "echo [BadgeOS] USB HID demo active"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        self.keyboard.write(
            "echo [BadgeOS] Host profile: Windows"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        self.keyboard.write(
            "start https://seccon.com"
        )

        self.keyboard.enter()

    # ---------------------------------------------------------
    # macOS demo
    # ---------------------------------------------------------

    def _demo_macos(self):
        """
        macOS HID demonstration.

        Opens Spotlight, launches Terminal, displays
        two harmless BadgeOS messages, then opens the
        conference website.
        """

        self.keyboard.hotkey(
            self.keyboard.MOD_LEFT_GUI,
            self.keyboard.KEY_SPACE,
        )

        time.sleep(
            0.50
        )

        self.keyboard.write(
            "Terminal"
        )

        self.keyboard.enter()

        time.sleep(
            0.85
        )

        self.keyboard.write(
            "echo '[BadgeOS] USB HID demo active'"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        self.keyboard.write(
            "echo '[BadgeOS] Host profile: macOS'"
        )

        self.keyboard.enter()

        time.sleep(
            0.45
        )

        self.keyboard.write(
            "open https://seccon.com"
        )

        self.keyboard.enter()

    # ---------------------------------------------------------
    # Host configuration
    # ---------------------------------------------------------

    @classmethod
    def _normalize_host(
        cls,
        host,
    ):
        value = str(
            host
        ).lower()

        if value == "mac":
            value = "macos"

        if value not in cls.VALID_HOSTS:
            raise ValueError(
                "Unknown HID host profile: {}".format(
                    host
                )
            )

        return value

    def set_host_profile(
        self,
        host,
    ):
        self.host_profile = self._normalize_host(
            host
        )

        self.log.info(
            "HID host profile: {}".format(
                self.host_profile
            )
        )

        return self.host_profile

    # ---------------------------------------------------------
    # Status
    # ---------------------------------------------------------

    def get_status(self):
        return {
            "host": self.host_profile,
            "state": self.state,
            "executions": self._send_count,
            "keyboard": self.keyboard is not None,
        }

    # ---------------------------------------------------------
    # LED state
    # ---------------------------------------------------------

    def _show_ready(self):
        self.state = "ready"

        self.led.off()

        self.led.set_pixel(
            0,
            self.COLOR_READY,
        )

    # ---------------------------------------------------------
    # Scheduler
    # ---------------------------------------------------------

    def update(self):
        pass
